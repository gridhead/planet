<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
  <head>
    <title><%= site.title %></title>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta http-equiv="content-type" content="application/xhtml+xml; charset=UTF-8">
    <meta http-equiv="Content-Type" content="text/html">
    <meta name="MSSmartTagsPreventParsing" content="TRUE">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="shortcut icon" href="/images-v2/favicon.ico">
    <link rel="icon" href="/images-v2/favicon.ico">
    <link rel="alternate" type="application/xml" title="RSS" href="<%= site.url %>/rss20.xml">
    <link rel="stylesheet" type="text/css" media="all" href="/static/main.css">
    <link rel="alternate" type="application/atom+xml" title="<%= site.title %> Atom 1.0" href="<%= site.url %>/atom.xml">
    <script src="/static/main.js"></script>
  </head>
<body>

<nav class="navbar navbar-expand bg-body-secondary shadow-sm p-0 sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center flex-grow-1" href="#">
      <img src="/assets/fedora.svg" id="logo" class="logo" width="30" height="30">
    </a>
    <div class="d-flex align-items-center gap-1">
      <form class="d-flex" role="search" onsubmit="return false">
        <input class="form-control form-control-sm" id="search-input" type="search" placeholder="Search" aria-label="Search"/>
      </form>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="/assets/mode-auto.svg" class="theme-icon" id="theme-icon-active" width="20" height="20" alt="">
          </a>
          <ul class="dropdown-menu dropdown-menu-end p-1">
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 p-1 small" href="#" data-bs-theme-value="auto">
                <img src="/assets/mode-auto.svg" class="theme-icon" width="18" height="18" alt="">
                System
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 p-1 small" href="#" data-bs-theme-value="light">
                <img src="/assets/mode-lite.svg" class="theme-icon" width="18" height="18" alt="">
                Light
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 p-1 small" href="#" data-bs-theme-value="dark">
                <img src="/assets/mode-dark.svg" class="theme-icon" width="18" height="18" alt="">
                Dark
              </a>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class="container small cont">
  <%
    items = site.items.latest.limit(24)
    ItemCursor.new( items ).each do |item, new_date, new_feed|
  %>
    <div class="row g-3 pt-3">
      <div class="col-12 col-lg-2">
        <div class="sticky-md-top side text-center">
          <% if item.feed.avatar %>
            <img class="hackergotchi" src="<%= item.feed.avatar %>" width="100" height="100" alt="">
            <br />
            <span class="fw-bold h6"><%= link_to item.feed.name, item.feed.url %></span>
            <br />
            <a href="https://accounts.fedoraproject.org/user/<%= item.feed.author %>">@<%= item.feed.author %></a>
          <% end %>
        </div>
      </div>
      <div class="col-12 col-lg-10">
        <div class="blog-entry-header mb-2">
          <h2>
          <% if item.url %>
            <%= link_to item.title, item.url %>
          <% else %>
            Untitled Post
          <% end %>
          </h2>
          <span class="text-secondary"><%= item.published.strftime('%B %d, %Y at %H:%M UTC') %></span>
        </div>
        <div class="blog-entry-content-container">
          <div class="blog-entry-content">
            <% if item.content %>
                <%= item.content %>
            <% elsif item.summary %>
                <%= item.summary %>
            <% else %>
                -/-
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <!-- <hr class="my-0" /> -->
  <% end %>
</div>

<div class="footer pt-2 pb-2">
    <div class="container text-muted text-xs-center">
        <p class="copy">&copy; 2016 Red Hat, Inc. and others. Please send any comments or corrections to the <a href="mailto:webmaster@fedoraproject.org">websites team</a>.</p>
        <p class="disclaimer">The Fedora Project is maintained and driven by the community and sponsored by Red Hat. This is a community maintained site. Red Hat is not responsible for content.</p>
        <p class="disclaimer">Your words are your own, duh. Nothing here represents Fedora™, Red Hat, Inc, or pretty much anything else. If you think it does then you are badly misled</p>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
